# AI Content Studio v2.7 — environment template
# Copy to apps/web/.env.local (and Vercel → Settings → Environment Variables).
# Never commit real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public URL n8n calls back to and links in Telegram point at (production domain).
ACS_API_BASE_URL=https://your-app.vercel.app
# Shared secret n8n sends as x-acs-service-token (same value as n8n $vars.ACS_INTERNAL_SERVICE_TOKEN).
ACS_INTERNAL_SERVICE_TOKEN=
# 64-hex AES key for YouTube OAuth tokens at rest.
ACS_CREDENTIAL_ENCRYPTION_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n (fast-path webhooks: <base>/acs-generate, /acs-render, /acs-agent-chat) ---
N8N_WEBHOOK_BASE_URL=https://your-instance.app.n8n.cloud/webhook

# --- Video (managed by Studio) ---
# Scene images, primary: OpenAI images. Empty = gpt-image-2.6-flare, then gpt-image-2 → gpt-image-1.5 → gpt-image-1-mini
# (each tried only if the previous model is unavailable). None of these need organization verification.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
# low | medium | high (default medium)
OPENAI_IMAGE_QUALITY=
# Scene images, backup: fal.ai (optional; needs account credit).
FAL_KEY=
# Optional overrides: text-to-image (default fal-ai/flux/dev), reference-guided (default fal-ai/flux-pro/kontext)
FAL_IMAGE_MODEL=
FAL_REFERENCE_MODEL=
# Remotion renderer on Railway (apps/renderer). Same RENDERER_TOKEN on both sides.
RENDERER_URL=https://your-renderer.up.railway.app
RENDERER_TOKEN=
# Optional narration + caption timing; leave empty for silent videos with evenly timed captions.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- YouTube publishing (Google Cloud OAuth client, YouTube Data API v3 enabled) ---
# Authorized redirect URI: ${ACS_API_BASE_URL}/api/integrations/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

