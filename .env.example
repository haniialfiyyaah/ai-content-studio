# =============================================================================
# AI Content Studio — environment template
# Copy to apps/web/.env.local and fill values. Never commit real secrets.
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
ACS_INTERNAL_SERVICE_TOKEN=local-internal-token-change-me
ACS_EXECUTION_CONTEXT_SECRET=local-execution-context-secret-change-me
ACS_CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# --- Supabase (from `supabase status` after `supabase start`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- n8n ---
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_ENCRYPTION_KEY=local-dev-only-change-me
ACS_API_BASE_URL=http://host.docker.internal:3000

# --- OpenAI (managed Studio key; optional for fixture mode) ---
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
ACS_AI_FIXTURE_MODE=true

# --- Managed allowance (illustrative monthly units) ---
ACS_MANAGED_MONTHLY_ALLOWANCE=500

# --- fal.ai (optional; fixtures when empty) ---
FAL_KEY=
ACS_FAL_FIXTURE_MODE=true

# --- ElevenLabs (optional; fixtures when empty) ---
ELEVENLABS_API_KEY=
ACS_ELEVENLABS_FIXTURE_MODE=true

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- YouTube OAuth (optional) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/integrations/social/youtube/callback

# --- Remotion worker ---
RENDER_WORKER_URL=http://localhost:3100
RENDER_WORKER_TOKEN=local-render-worker-token
