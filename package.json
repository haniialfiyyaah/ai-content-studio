{
  "name": "ai-content-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:start": "supabase start --ignore-health-check -x logflare,vector",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "n8n:up": "docker-compose up -d n8n",
    "n8n:down": "docker-compose down",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
