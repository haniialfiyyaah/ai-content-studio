# Versions from the working mart-ops reference, not floating latest tags.
# Keep n8n and its task runners on the SAME version (N8N_VERSION).
N8N_VERSION=2.44.7
CADDY_VERSION=2.11.7-alpine
POSTGRES_VERSION=16.15-alpine

# Hostname only: no https://, path, or trailing slash.
DOMAIN_NAME=
SSL_EMAIL=

# Generate each value separately on the NEW server: openssl rand -hex 32
# Keep the encryption key unchanged after first startup; back it up securely.
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=

# Generate a THIRD separate value: openssl rand -hex 32
# Applied when postgres_data is first initialized. Later password rotation
# requires updating the database role as well as this value.
POSTGRES_PASSWORD=

# --- AI Content Studio app settings (read by workflows via $env) ---
ACS_API_BASE_URL=https://ai-content-studio-one-sigma.vercel.app
# Same value as ACS_INTERNAL_SERVICE_TOKEN in Vercel.
ACS_INTERNAL_SERVICE_TOKEN=
TELEGRAM_BOT_TOKEN=

# --- Renderer (Remotion) ---
# openssl rand -hex 32 — set the same value as RENDERER_TOKEN in Vercel.
RENDERER_TOKEN=
