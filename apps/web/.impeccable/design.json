{
  "version": 1,
  "name": "Calm Studio",
  "buildPath": "code",
  "supersedes": "Two-Ink Press",
  "surface": "src-app-app-page-tsx",
  "layout": "conversation-first",
  "palette": "stone",
  "fonts": {
    "body": "Archivo",
    "mono": "Spline Sans Mono"
  },
  "tokens": {
    "stone": "#f3f2ef",
    "stoneDeep": "#e9e7e2",
    "white": "#ffffff",
    "ink": "#26292b",
    "inkMuted": "#5f6467",
    "rule": "#e2e0da",
    "ruleStrong": "#c8c5be",
    "ruleInput": "#8f8b83",
    "sage": "#e2ebe2",
    "sageInk": "#46644d",
    "sageDot": "#7f9e86",
    "sand": "#efe6d7",
    "sandInk": "#6a5434",
    "sandDot": "#c6975a",
    "teal": "#2f6f6a",
    "tealPress": "#275d59",
    "tealTint": "#dde9e6",
    "clay": "#a8493c",
    "clayTint": "#f5e2dd",
    "radius": "12px",
    "radiusSm": "8px",
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "roles": {
    "agent": ["sage", "sageInk", "sageDot"],
    "creator": ["sand", "sandInk", "sandDot"],
    "primaryAction": ["teal", "tealPress", "tealTint"],
    "blocked": ["clay", "clayTint"],
    "ground": ["stone", "stoneDeep", "white"],
    "text": ["ink", "inkMuted"]
  },
  "contrast": {
    "inkOnStone": 13.08,
    "mutedOnStone": 5.35,
    "mutedOnWhite": 5.99,
    "sageInkOnSage": 5.4,
    "sandInkOnSand": 5.79,
    "whiteOnTeal": 5.83,
    "tealOnTealTint": 4.68,
    "clayOnWhite": 5.7,
    "clayOnClayTint": 4.56,
    "ruleInputOnWhite": 3.39,
    "ruleInputOnStone": 3.03
  },
  "rules": [
    "Agent offers buttons only; approve concept, authorize spend, approve video, and publish are four separate creator clicks.",
    "Real data only: no invented counts or stages.",
    "Teal for primary actions and completed gates; clay for blocked/failed only.",
    "No gradients, no decorative shadows.",
    "Consent colour is never the sole signal: detail text + sr-only state accompany every gate.",
    "Form-field borders use --rule-input for WCAG 1.4.11.",
    "Remotion composition and video player stay outside this palette."
  ],
  "components": [
    "app-rail",
    "app-mobilebar",
    "app-tabbar",
    "home",
    "studio-thread",
    "decision-card",
    "today-panel",
    "consent-track",
    "authorize-spend-button",
    "project-tile",
    "project-card",
    "primary-button",
    "secondary-button",
    "pill"
  ],
  "sources": [
    "src/app/globals.css",
    "src/app/layout.tsx",
    "src/components/layout/app-shell.tsx",
    "src/components/home/studio-thread.tsx",
    "src/components/home/decision-card.tsx",
    "src/components/home/today-panel.tsx",
    "src/components/consent/consent-track.tsx",
    "src/components/consent/authorize-spend-button.tsx",
    "src/lib/consent-track.ts",
    "src/lib/project-tone.ts"
  ]
}
