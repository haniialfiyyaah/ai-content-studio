{
  "name": "WF-04 Error Handling",
  "nodes": [
    {
      "parameters": {},
      "id": "wf04-01-error-trigger",
      "name": "04-01 Automatic failure",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "workflowId",
              "name": "workflowId",
              "value": "={{ $json.workflow?.id || $json.workflowId || '' }}",
              "type": "string"
            },
            {
              "id": "executionId",
              "name": "executionId",
              "value": "={{ $json.execution?.id || $json.executionId || '' }}",
              "type": "string"
            },
            {
              "id": "runId",
              "name": "runId",
              "value": "={{ $json.execution?.error?.context?.runId || $json.runId || '' }}",
              "type": "string"
            },
            {
              "id": "correlationId",
              "name": "correlationId",
              "value": "={{ $json.execution?.error?.context?.correlationId || $json.correlationId || '' }}",
              "type": "string"
            },
            {
              "id": "errorMessage",
              "name": "errorMessage",
              "value": "={{ ($json.execution?.error?.message || $json.message || 'Unknown workflow error').toString().slice(0, 500) }}",
              "type": "string"
            },
            {
              "id": "errorCategory",
              "name": "errorCategory",
              "value": "platform",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "wf04-02-sanitize",
      "name": "04-02 Sanitize error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.ACS_API_BASE_URL}}/api/internal/workflows/record-error",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-acs-service-token",
              "value": "={{$env.ACS_INTERNAL_SERVICE_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflowId\": \"{{ $json.workflowId }}\",\n  \"executionId\": \"{{ $json.executionId }}\",\n  \"runId\": \"{{ $json.runId }}\",\n  \"correlationId\": \"{{ $json.correlationId }}\",\n  \"category\": \"{{ $json.errorCategory }}\",\n  \"message\": {{ JSON.stringify($json.errorMessage) }},\n  \"sanitized\": true\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "wf04-03-record-error",
      "name": "04-03 Record incident",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0]
    }
  ],
  "connections": {
    "04-01 Automatic failure": {
      "main": [
        [
          {
            "node": "04-02 Sanitize error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "04-02 Sanitize error": {
      "main": [
        [
          {
            "node": "04-03 Record incident",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
