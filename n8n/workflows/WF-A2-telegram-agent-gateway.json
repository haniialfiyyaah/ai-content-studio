      "typeVersion": 2.2,
      "position": [
        448,
        224
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.ACS_API_BASE_URL }}/api/internal/telegram/resolve-actor",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-acs-service-token",
              "value": "={{ $vars.ACS_INTERNAL_SERVICE_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"updateId\": \"{{ $('A2-02 Normalize update').item.json.updateId }}\", \"chatId\": \"{{ $('A2-02 Normalize update').item.json.chatId }}\", \"telegramUserId\": \"{{ $('A2-02 Normalize update').item.json.userId }}\", \"messageId\": \"{{ $('A2-02 Normalize update').item.json.messageId }}\", \"text\": {{ JSON.stringify($('A2-02 Normalize update').item.json.text || '') }} }",
        "options": {
          "timeout": 30000
        }
      },
      "id": "99720bdd-eda8-42ee-b755-0e1071752506",
      "name": "A2-04 Resolve Studio actor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        144
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "linked",
              "leftValue": "={{ $json.data?.linked ?? $json.linked ?? false }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a153bbdc-c086-41e5-8332-3e61086a37ad",
      "name": "A2-05 Actor linked?",
