        ],
        "additionalFields": {}
      },
      "id": "23a8f9ba-11a1-4304-9aba-f6b64c2d8a75",
      "name": "A2-01 Telegram updates",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        224
      ],
      "webhookId": "39f89ffd-9a08-40c3-b6a8-19a2a3b4009c",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "updateId",
              "name": "updateId",
              "value": "={{ $json.update_id || $json.updateId || '' }}",
              "type": "string"
            },
            {
              "id": "chatId",
              "name": "chatId",
              "value": "={{ ($json.message || $json.callback_query?.message || {}).chat?.id || $json.chatId || '' }}",
              "type": "string"
            },
            {
              "id": "chatType",
              "name": "chatType",
              "value": "={{ ($json.message || $json.callback_query?.message || {}).chat?.type || 'unknown' }}",
              "type": "string"
            },
            {
              "id": "userId",
              "name": "userId",
              "value": "={{ ($json.message || $json.callback_query || {}).from?.id || $json.userId || '' }}",
              "type": "string"
            },
            {
              "id": "messageId",
              "name": "messageId",
              "value": "={{ ($json.message || $json.callback_query?.message || {}).message_id || $json.messageId || '' }}",
              "type": "string"
            },
            {
              "id": "text",
              "name": "text",
              "value": "={{ $json.message?.text || $json.callback_query?.data || '' }}",
              "type": "string"
            },
            {
              "id": "hasAttachment",
              "name": "hasAttachment",
              "value": "={{ !!( $json.message?.photo || $json.message?.voice || $json.message?.document || $json.message?.audio || $json.message?.video ) }}",
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "id": "721905af-819b-47bd-9ab7-5eb8702d7300",
      "name": "A2-02 Normalize update",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        224
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "private-chat",
              "leftValue": "={{ $json.chatType }}",
              "rightValue": "private",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "634d70be-4833-4f9c-8845-3e7e394f9db2",
      "name": "A2-03 Supported private update?",
