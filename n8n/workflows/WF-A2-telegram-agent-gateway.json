        "chatId": "={{ $('A2-02 Normalize update').item.json.chatId }}",
        "text": "=Your Telegram is not linked to AI Content Studio yet. Open Studio → Settings → Telegram, paste your numeric user ID ({{ $('A2-02 Normalize update').item.json.userId }}), link, then message me again.",
