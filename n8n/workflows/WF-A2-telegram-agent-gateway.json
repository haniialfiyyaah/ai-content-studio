        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"telegramUserId\": \"{{ $('A2-02 Normalize update').item.json.userId }}\",\n  \"chatId\": \"{{ $('A2-02 Normalize update').item.json.chatId }}\",\n  \"updateId\": \"{{ $('A2-02 Normalize update').item.json.updateId }}\",\n  \"messageId\": \"{{ $('A2-02 Normalize update').item.json.messageId }}\",\n  \"text\": {{ JSON.stringify($('A2-02 Normalize update').item.json.text || '') }},\n  \"correlationId\": \"{{ $json.data?.correlationId || $json.correlationId || $('A2-02 Normalize update').item.json.updateId }}\"\n}",
        "options": {
          "timeout": 30000
        },
        "contentType": "json"
