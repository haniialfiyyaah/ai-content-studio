          "appendAttribution": false
        }
      },
      "webhookId": "696bb00c-276a-4ab5-b07a-e62f0a520988",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
