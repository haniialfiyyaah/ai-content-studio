    {
      "parameters": {
        "method": "POST",
        "url": "={{$vars.ACS_API_BASE_URL}}/api/internal/automation/claim-due",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-acs-service-token",
              "value": "={{$vars.ACS_INTERNAL_SERVICE_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"kind\": \"ideation\",\n  \"limit\": 10\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "wf01-02-claim-due",
      "name": "01-02 Claim due work",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-items",
              "leftValue": "={{ ($json.data?.occurrences || $json.occurrences || []).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "wf01-03-if-due",
      "name": "01-03 Has due occurrences?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "occurrence",
              "name": "occurrence",
              "value": "={{ ($json.data?.occurrences || $json.occurrences || [])[0] }}",
              "type": "object"
            },
            {
              "id": "occurrenceId",
              "name": "occurrenceId",
              "value": "={{ ($json.data?.occurrences || $json.occurrences || [])[0]?.occurrenceId || ($json.data?.occurrences || $json.occurrences || [])[0]?.id || '' }}",
              "type": "string"
            },
            {
              "id": "projectId",
              "name": "projectId",
              "value": "={{ ($json.data?.occurrences || $json.occurrences || [])[0]?.projectId || '' }}",
              "type": "string"
            },
            {
              "id": "jobId",
              "name": "jobId",
              "value": "={{ ($json.data?.occurrences || $json.occurrences || [])[0]?.jobId || ($json.data?.occurrences || $json.occurrences || [])[0]?.runId || '' }}",
              "type": "string"
            },
            {
              "id": "strategy",
              "name": "strategy",
              "value": "={{ ($json.data?.occurrences || $json.occurrences || [])[0]?.strategy || 'original' }}",
              "type": "string"
            },
            {
              "id": "correlationId",
              "name": "correlationId",
              "value": "={{ ($json.data?.occurrences || $json.occurrences || [])[0]?.correlationId || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "wf01-04-pick",
      "name": "01-04 Pick occurrence",
