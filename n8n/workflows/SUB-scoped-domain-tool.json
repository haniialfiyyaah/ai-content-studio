{
  "name": "SUB Scoped Domain Tool",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "sub-sdt-01-trigger",
      "name": "SDT-01 Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "toolName",
              "name": "toolName",
              "value": "={{ $json.toolName || $json.operation || '' }}",
              "type": "string"
            },
            {
              "id": "runId",
              "name": "runId",
              "value": "={{ $json.runId || $json.jobId || '' }}",
              "type": "string"
            },
            {
              "id": "projectId",
              "name": "projectId",
              "value": "={{ $json.projectId || '' }}",
              "type": "string"
            },
            {
              "id": "conversationId",
              "name": "conversationId",
              "value": "={{ $json.conversationId || '' }}",
              "type": "string"
            },
            {
              "id": "correlationId",
              "name": "correlationId",
              "value": "={{ $json.correlationId || '' }}",
              "type": "string"
            },
            {
              "id": "args",
              "name": "args",
              "value": "={{ $json.args || $json.input || {} }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "sub-sdt-02-normalize",
      "name": "SDT-02 Normalize tool request",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-tool",
              "leftValue": "={{ $json.toolName }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "sub-sdt-03-if",
      "name": "SDT-03 Tool named?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$vars.ACS_API_BASE_URL}}/api/internal/ai/check-policy",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-acs-service-token",
              "value": "={{$vars.ACS_INTERNAL_SERVICE_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"runId\": \"{{ $json.runId }}\",\n  \"projectId\": \"{{ $json.projectId }}\",\n  \"conversationId\": \"{{ $json.conversationId }}\",\n  \"correlationId\": \"{{ $json.correlationId }}\",\n  \"purpose\": \"agent_tool\",\n  \"toolName\": \"{{ $json.toolName }}\"\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "sub-sdt-04-policy",
      "name": "SDT-04 Check tool policy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$vars.ACS_API_BASE_URL}}/api/internal/agent/tool",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-acs-service-token",
              "value": "={{$vars.ACS_INTERNAL_SERVICE_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"runId\": \"{{ $('SDT-02 Normalize tool request').item.json.runId }}\",\n  \"projectId\": \"{{ $('SDT-02 Normalize tool request').item.json.projectId }}\",\n  \"conversationId\": \"{{ $('SDT-02 Normalize tool request').item.json.conversationId }}\",\n  \"correlationId\": \"{{ $('SDT-02 Normalize tool request').item.json.correlationId }}\",\n  \"toolName\": \"{{ $('SDT-02 Normalize tool request').item.json.toolName }}\",\n  \"args\": {{ JSON.stringify($('SDT-02 Normalize tool request').item.json.args || {}) }}\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "sub-sdt-05-execute",
      "name": "SDT-05 Execute scoped tool",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        -80
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "ok",
              "name": "ok",
              "value": "={{ !($json.data?.error || $json.error) }}",
              "type": "boolean"
            },
            {
              "id": "toolName",
              "name": "toolName",
              "value": "={{ $('SDT-02 Normalize tool request').item.json.toolName }}",
              "type": "string"
            },
            {
              "id": "result",
              "name": "result",
              "value": "={{ $json.data || $json }}",
              "type": "object"
            },
            {
              "id": "runId",
              "name": "runId",
              "value": "={{ $('SDT-02 Normalize tool request').item.json.runId }}",
              "type": "string"
            },
            {
              "id": "correlationId",
              "name": "correlationId",
              "value": "={{ $('SDT-02 Normalize tool request').item.json.correlationId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "sub-sdt-06-sanitize",
      "name": "SDT-06 Sanitize tool result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1300,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$vars.ACS_API_BASE_URL}}/api/internal/workflows/record-error",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-acs-service-token",
              "value": "={{$vars.ACS_INTERNAL_SERVICE_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"runId\": \"{{ $json.runId }}\",\n  \"correlationId\": \"{{ $json.correlationId }}\",\n  \"category\": \"VALIDATION\",\n  \"message\": \"Scoped domain tool missing toolName\",\n  \"sanitized\": true\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "sub-sdt-07-error",
      "name": "SDT-07 Record invalid tool",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        120
      ]
    }
  ],
  "connections": {
    "SDT-01 Start": {
      "main": [
        [
          {
            "node": "SDT-02 Normalize tool request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SDT-02 Normalize tool request": {
      "main": [
        [
          {
            "node": "SDT-03 Tool named?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SDT-03 Tool named?": {
      "main": [
        [
          {
            "node": "SDT-04 Check tool policy",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "SDT-07 Record invalid tool",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SDT-04 Check tool policy": {
      "main": [
        [
          {
            "node": "SDT-05 Execute scoped tool",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SDT-05 Execute scoped tool": {
      "main": [
        [
          {
            "node": "SDT-06 Sanitize tool result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [],
  "active": false
}
