            {
              "id": "correlationId",
              "name": "correlationId",
              "value": "={{ ($json.data?.jobs || $json.jobs || [])[0]?.correlationId || ($json.data?.jobs || $json.jobs || [])[0]?.idempotencyKey || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
