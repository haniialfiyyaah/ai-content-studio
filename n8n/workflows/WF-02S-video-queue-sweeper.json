{
  "name": "WF-02S Video Queue Sweeper",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "wf02s-01",
      "name": "02S-01 Every 2 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.ACS_API_BASE_URL }}/api/internal/automation/claim-due",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-acs-service-token",
              "value": "={{ $vars.ACS_INTERNAL_SERVICE_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{ \"kind\": \"video_jobs\", \"limit\": 10 }",
        "options": {
          "timeout": 30000
        }
      },
      "id": "wf02s-02",
      "name": "02S-02 Find stale queued videos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-jobs",
              "leftValue": "={{ ($json.data?.jobs || []).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf02s-03",
      "name": "02S-03 Any stale jobs?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data.jobs",
        "include": "noOtherFields"
      },
      "id": "wf02s-04",
      "name": "02S-04 One item per job",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1.1,
      "position": [
        672,
        -96
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "name",
          "value": "WF-02 Video Production"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": false
        }
      },
      "id": "wf02s-05",
      "name": "02S-05 Start WF-02 per job",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        896,
        -96
      ]
    },
    {
      "parameters": {},
      "id": "wf02s-06",
      "name": "02S-06 Nothing stale",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        672,
        96
      ]
    }
  ],
  "connections": {
    "02S-01 Every 2 minutes": {
      "main": [
        [
          {
            "node": "02S-02 Find stale queued videos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "02S-02 Find stale queued videos": {
      "main": [
        [
          {
            "node": "02S-03 Any stale jobs?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "02S-03 Any stale jobs?": {
      "main": [
        [
          {
            "node": "02S-04 One item per job",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "02S-06 Nothing stale",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "02S-04 One item per job": {
      "main": [
        [
          {
            "node": "02S-05 Start WF-02 per job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [],
  "active": false
}
