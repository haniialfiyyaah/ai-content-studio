{
  "name": "SUB Progress Reporter",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "sub-pr-01-trigger",
      "name": "PR-01 Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "runId",
              "name": "runId",
              "value": "={{ $json.runId || $json.jobId || '' }}",
              "type": "string"
            },
            {
              "id": "stage",
              "name": "stage",
              "value": "={{ $json.stage || 'progress' }}",
              "type": "string"
            },
            {
              "id": "state",
              "name": "state",
              "value": "={{ $json.state || 'running' }}",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "={{ ($json.message || '').toString().slice(0, 500) }}",
              "type": "string"
            },
            {
              "id": "correlationId",
              "name": "correlationId",
              "value": "={{ $json.correlationId || '' }}",
              "type": "string"
            },
            {
              "id": "eventId",
              "name": "eventId",
              "value": "={{ $json.eventId || $json.cursor || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "sub-pr-02-validate",
      "name": "PR-02 Validate stage payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-run",
              "leftValue": "={{ $json.runId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "sub-pr-03-if",
      "name": "PR-03 Has runId?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.ACS_API_BASE_URL}}/api/internal/jobs/progress",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-acs-service-token",
              "value": "={{$env.ACS_INTERNAL_SERVICE_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jobId\": \"{{ $json.runId }}\",\n  \"runId\": \"{{ $json.runId }}\",\n  \"stage\": \"{{ $json.stage }}\",\n  \"state\": \"{{ $json.state }}\",\n  \"message\": {{ JSON.stringify($json.message) }},\n  \"correlationId\": \"{{ $json.correlationId }}\",\n  \"eventId\": \"{{ $json.eventId }}\"\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "sub-pr-04-progress",
      "name": "PR-04 Record progress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.ACS_API_BASE_URL}}/api/internal/workflows/record-error",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-acs-service-token",
              "value": "={{$env.ACS_INTERNAL_SERVICE_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"category\": \"VALIDATION\",\n  \"message\": \"Progress reporter missing runId\",\n  \"correlationId\": \"{{ $json.correlationId }}\",\n  \"sanitized\": true\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "sub-pr-05-error",
      "name": "PR-05 Record missing runId",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        120
      ]
    }
  ],
  "connections": {
    "PR-01 Start": {
      "main": [
        [
          {
            "node": "PR-02 Validate stage payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "PR-02 Validate stage payload": {
      "main": [
        [
          {
            "node": "PR-03 Has runId?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "PR-03 Has runId?": {
      "main": [
        [
          {
            "node": "PR-04 Record progress",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "PR-05 Record missing runId",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [],
  "active": false
}
